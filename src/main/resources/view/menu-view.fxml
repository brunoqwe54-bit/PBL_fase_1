<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controller.fx.MenuController" styleClass="fundo-menu">
    <Region styleClass="sombra-menu" />
    <VBox alignment="CENTER" spacing="10" maxWidth="400" maxHeight="-Infinity" styleClass="painel-menu">
        <Label text="RIACHO DO FOGO · UMA NOITE POR ANO" styleClass="legenda" />
        <Label text="A NOITE LONGA" styleClass="titulo-jogo" />
        <Label text="Sua irmã saiu. Você vai atrás dela." styleClass="muted" />
        <Region prefHeight="12" />
        <Button text="Nova partida" onAction="#onNovaPartidaClick" maxWidth="Infinity" styleClass="principal" />
        <Button fx:id="continuar" text="Continuar" onAction="#onContinuarClick" maxWidth="Infinity" />
        <Button text="Carregar / gerenciar saves" onAction="#onCarregarClick" maxWidth="Infinity" />
        <Button text="Configurações" onAction="#onPreferenciasClick" maxWidth="Infinity" />
        <Button text="Galeria de finais" onAction="#onGaleriaClick" maxWidth="Infinity" />
        <HBox alignment="CENTER" spacing="12">
            <Button text="Instruções" onAction="#onInstrucoesClick" />
            <Button text="Créditos" onAction="#onCreditosClick" />
            <Button text="Sair" onAction="#onSairClick" />
        </HBox>
        <Label text="Um jogo de escolhas e consequências" styleClass="legenda" />
    </VBox>
</StackPane>
