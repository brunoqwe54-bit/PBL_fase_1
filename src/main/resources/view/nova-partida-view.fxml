<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="view.NovaPartidaController" styleClass="fundo-menu">
    <Region styleClass="sombra-menu" />
    <VBox alignment="CENTER_LEFT" spacing="16" maxWidth="580" maxHeight="-Infinity" styleClass="painel-menu">
        <Label text="ANTES DE ABRIR A PORTA" styleClass="legenda" />
        <Label text="Quem enfrenta a noite?" styleClass="titulo" />
        <Label wrapText="true" text="Em Riacho do Fogo, ninguém sai na Noite Longa. A Procissão convida com a voz de quem faz falta. Manuela, sua irmã de dezessete anos, saiu. Encontre-a antes do amanhecer." />
        <Label text="Seu nome" />
        <TextField fx:id="campoNome" promptText="Vicente" />
        <Label text="Como você enfrenta o desconhecido?" />
        <ComboBox fx:id="comboPreset" maxWidth="Infinity" onAction="#onPresetEscolhido" />
        <Label fx:id="descricaoPreset" wrapText="true" minHeight="75" />
        <HBox spacing="12">
            <Button text="Voltar" onAction="#onVoltarClick" />
            <Button text="Começar a noite" onAction="#onComecarClick" defaultButton="true" styleClass="principal" />
        </HBox>
    </VBox>
</StackPane>
