<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.fx.JogoViewController" styleClass="tela-jogo">
    <top>
        <VBox spacing="8" styleClass="cabecalho">
            <HBox alignment="CENTER_LEFT" spacing="16">
                <Label fx:id="tituloCena" styleClass="subtitulo" />
                <Region HBox.hgrow="ALWAYS" />
                <ProgressBar fx:id="progresso" prefWidth="130" />
                <Label fx:id="progressoTexto" />
                <Button text="Status" onAction="#onStatusClick" />
                <MenuButton text="Menu">
                    <items>
                        <MenuItem text="Salvar partida" onAction="#onSalvarClick" />
                        <MenuItem text="Carregar partida" onAction="#onCarregarClick" />
                        <MenuItem text="Configurações" onAction="#onPreferenciasClick" />
                        <SeparatorMenuItem />
                        <MenuItem text="Reiniciar" onAction="#onReiniciarClick" />
                        <MenuItem text="Menu inicial" onAction="#onMenuInicialClick" />
                        <MenuItem text="Sair" onAction="#onSairClick" />
                    </items>
                </MenuButton>
            </HBox>
            <Label fx:id="status" styleClass="muted" wrapText="true" />
        </VBox>
    </top>
    <center>
        <StackPane>
            <Region fx:id="cenario" />
            <Region styleClass="sombra-cenario" />
            <VBox fx:id="personagemVisual" alignment="BOTTOM_CENTER" maxWidth="180" maxHeight="270"
                  translateX="-330" spacing="6" mouseTransparent="true" visible="false">
                <Circle radius="39" fill="#161721" stroke="#b7a4d9" strokeWidth="2" />
                <SVGPath content="M 0 120 Q 0 12 80 12 Q 160 12 160 120 Z" fill="#161721" stroke="#b7a4d9" strokeWidth="2" />
                <Label fx:id="nomePersonagem" styleClass="nome-personagem" wrapText="true" />
            </VBox>
            <ScrollPane fx:id="listaOpcoes" fitToWidth="true" maxWidth="650" maxHeight="390"
                        visible="false" styleClass="escolhas" hbarPolicy="NEVER">
                <content><VBox fx:id="opcoes" spacing="8" styleClass="lista-escolhas" /></content>
            </ScrollPane>
        </StackPane>
    </center>
    <bottom>
        <VBox spacing="9" styleClass="caixa-dialogo">
            <ScrollPane fx:id="leitura" fitToWidth="true" prefViewportHeight="135" hbarPolicy="NEVER">
                <content><Label fx:id="texto" wrapText="true" styleClass="narrativa" maxWidth="Infinity" /></content>
            </ScrollPane>
            <HBox alignment="CENTER_LEFT" spacing="16">
                <Button fx:id="botaoContinuar" defaultButton="true" text="Continuar  [ENTER]"
                        onAction="#onContinuarClick" styleClass="principal" />
                <Label fx:id="avisos" wrapText="true" maxHeight="62" styleClass="aviso" HBox.hgrow="ALWAYS" />
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
