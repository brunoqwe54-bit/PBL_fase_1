<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="view.SlotsController" styleClass="pagina">
    <top><VBox spacing="8" styleClass="cabecalho">
        <Label fx:id="titulo" styleClass="titulo" />
        <Label text="Três espaços manuais e um autosave. Seus caminhos ficam guardados aqui." wrapText="true" />
        <Label fx:id="mensagem" styleClass="aviso" />
    </VBox></top>
    <center><ScrollPane fitToWidth="true" hbarPolicy="NEVER">
        <content><VBox fx:id="slots" spacing="12" styleClass="conteudo" /></content>
    </ScrollPane></center>
    <bottom><HBox styleClass="rodape"><Button text="Voltar" onAction="#onVoltarClick" /></HBox></bottom>
</BorderPane>
